class Solution:
    def minDifference(self, arr):
        seconds = []
        
        for t in arr:
            h, m, s = map(int, t.split(":"))
            seconds.append(h*3600 + m*60 + s)
        
        seconds.sort()
        n = len(seconds)
        
        min_diff = float('inf')
        
        for i in range(1, n):
            min_diff = min(min_diff, seconds[i] - seconds[i-1])
        
        min_diff = min(min_diff, 86400 - seconds[-1] + seconds[0])
        
        return min_diff
