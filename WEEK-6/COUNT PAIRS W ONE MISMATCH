class Solution:
    def countPairs(self, arr):
        n = len(arr)
        count = 0
        
        for i in range(n):
            for j in range(i+1, n):
                diff = 0
                for a, b in zip(arr[i], arr[j]):
                    if a != b:
                        diff += 1
                        if diff > 1:
                            break
                if diff == 1:
                    count += 1
        
        return count
