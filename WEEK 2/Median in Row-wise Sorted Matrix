class Solution:
    def median(self, matrix, r, c):
        low = min(row[0] for row in matrix)
        high = max(row[-1] for row in matrix)
        
        while low < high:
            mid = (low + high) // 2
            count = 0
            
            for row in matrix:
                l, h = 0, c
                while l < h:
                    m = (l + h) // 2
                    if row[m] <= mid:
                        l = m + 1
                    else:
                        h = m
                count += l
            
            if count <= (r * c) // 2:
                low = mid + 1
            else:
                high = mid
        
        return low
